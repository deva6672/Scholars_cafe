# ============================================
# The Scholars Cafe Chatbot - Backend Config
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to GitHub.
# ============================================

# Server
PORT=5001
NODE_ENV=development

# Anthropic API key (server-side ONLY, never exposed to the frontend)
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use
CLAUDE_MODEL=claude-sonnet-5

# Allowed origin(s) for CORS - your deployed frontend URL(s), comma separated
FRONTEND_URL=http://localhost:5173

# Admin panel login (change these before deploying!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_before_deploying
JWT_SECRET=change_this_to_a_long_random_secret_string

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
